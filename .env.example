# ─────────────────────────────────────────────────────────────────────────────
# .env.example, template for local Docker Compose development
#
# Copy this file to .env and fill in your values:
#
# .env is git-ignored
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_DB=mealchemy_dev
POSTGRES_USER=mealchemy_user
POSTGRES_PASSWORD=changeme

# ── pgAdmin───────────────────────────
PGADMIN_EMAIL=admin@mealchemy.dev
PGADMIN_PASSWORD=admin
