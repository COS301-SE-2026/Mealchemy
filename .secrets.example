# ─────────────────────────────────────────────────────────────────────────────
# .secrets.example = template for act local secrets
#
# Copy this file to .secrets and fill in your values:
#   cp .secrets.example .secrets
#
# .secrets is git-ignored
# These names match the GitHub Actions Secrets used in ci.yml 
# ─────────────────────────────────────────────────────────────────────────────

# ── CI — PostgreSQL integration test container ────────────────────────────────
# act spins up a throwaway container using these values.
# They don't connect to any real database, choose anything you like.
DB_USER=mealchemy_ci
DB_PASSWORD=mealchemy_ci_pass


