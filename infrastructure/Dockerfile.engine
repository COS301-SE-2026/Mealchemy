# ─────────────────────────────────────────────────────────────────────────────
#Dockerfile.engine, Python 3.12 Recommendation Engine
#this to be rechecked when engine implementation starts
#
#notes
#     — Multi-stage build; source code not in final image
#     — Non-root user; base images pinned to SHA256 digest
#    — HEALTHCHECK defined; resource limits set in docker-compose.yml
#    — Supply chain: digest pins prevent image swaps
# ─────────────────────────────────────────────────────────────────────────────

# Build / dependency installation ─────────────────────────────────
# Pinned to SHA256 digest
# python:3.12.3-slim-bookworm
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

RUN pip install --no-cache-dir pip==24.0

COPY engine/requirements.txt .

# Create /install first so the directory always exists even if requirements.txt is empty,
# then install packages into it so only they are copied to runtime
RUN mkdir -p /install && pip install --no-cache-dir --prefix=/install -r requirements.txt

# Runtime ──────────────────────────────────────────────────────────
# Same base as builder for consistency
# python:3.12.3-slim-bookworm
FROM python:3.12-slim-bookworm AS runtime

# Prevent .pyc files and ensure stdout/stderr are not buffered in the container
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Create a non-root user
RUN groupadd --system mealchemy && \
    useradd --system --gid mealchemy --no-create-home mealchemy

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy only the engine source, no test files, no dev config
COPY engine/src ./src

RUN chown -R mealchemy:mealchemy /app

USER mealchemy

EXPOSE 8000

# HEALTHCHECK
# Update this to match actual engine start command:
#   FastAPI/uvicorn: checks /health endpoint
#  
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Entry point ───────────────────────────────────────────────────────────────
# Update this when engine's start command is finalised:
#
CMD ["python", "src/main.py"]

#  Resource limits ───────────────────────────────────────────────────────────
# CPU and memory limits are set in docker-compose.yml 
