#  application-test.properties.example ──────────────────────────────────────
# Copy this file to application-test.properties and fill in your local values.
# application-test.properties is gitignored
#
# This file is loaded automatically when @ActiveProfiles("test") is set,
# layered on top of application.properties so these values take priority.
# Required to run @SpringBootTest integration tests locally.
# ─────────────────────────────────────────────────────────────────────────────

# Match the values in your .env file

spring.datasource.url=jdbc:postgresql://localhost:5432/<POSTGRES_DB>
spring.datasource.username=<POSTGRES_USER>
spring.datasource.password=<POSTGRES_PASSWORD>

# Match the values in your .env file

jwt.secret=<JWT_SECRET>
jwt.expiration-ms=<JWT_EXPIRATION_MS>
